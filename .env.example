# Local settings. Copy to .env (gitignored) and fill in JWT_SECRET, then run commands with:
#   uv run --env-file .env flask --app app:create_local_app run
# In production these come from the environment, e.g. injected from a secret manager.

# The docker compose database (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5434/shop_payments

# HS256 key shared with the identity provider (NFR-9). At least 32 bytes; no default, so the
# app refuses to start without it. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# Must match the iss and aud claims of the access tokens.
JWT_ISSUER=https://id.shop.local
JWT_AUDIENCE=shop-payments-api
